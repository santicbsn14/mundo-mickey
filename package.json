{
  "name": "mundo-mickey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,gray \"vite\" \"node --watch server/dev.js\"",
    "dev:host": "concurrently -n web,api -c yellow,gray \"vite --host\" \"node --watch server/dev.js\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "seed": "node scripts/seed.js",
    "seed:limpiar": "node scripts/limpiar-seed.js",
    "admin:hash": "node scripts/hash-password.js",
    "imagenes:limpiar": "node scripts/limpiar-imagenes.js"
  },
  "dependencies": {
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
