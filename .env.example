# Solo las variables VITE_ llegan al navegador. Nunca pongas un secreto con prefijo VITE_.
# Copiá este archivo a .env y completá los valores. El .env no se versiona.

# --- API ---
# MongoDB Atlas (ver docs/DEPLOY.md): en local la base "mundo-mickey-dev", en Vercel "mundo-mickey".
# En una red que no resuelve SRV (querySrv ECONNREFUSED), usá la cadena estándar mongodb:// con los tres hosts.
# Formato, con valores de ejemplo:
# mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/mundo-mickey-dev?retryWrites=true&w=majority&appName=mundo-mickey
MONGODB_URI=
# URL pública del sitio, sin / al final. Arma las back_urls de Mercado Pago (y la notification_url, solo si es https).
# En local, el front de Vite; con el túnel (npm run tunel), la URL https del túnel; en el deploy de prueba,
# https://mundo-mickey.vercel.app; en producción, el dominio final (brief 12). Sin comillas.
SITE_URL=http://localhost:5173

# --- Front (públicas) ---
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# --- Sanity (API) ---
# Mismo proyecto y dataset que las VITE_. El token (rol Editor) es secreto: solo en el servidor y en los scripts.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=

# --- Login del panel (/admin) ---
# Usuario del único admin, por ejemplo: admin
ADMIN_USER=
# Hash bcrypt de la contraseña: generalo con `npm run admin:hash` y pegalo tal cual, sin comillas
ADMIN_PASSWORD_HASH=
# Secreto para firmar los JWT. Generalo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Mercado Pago (Checkout Pro) ---
# Secreto, sin VITE_. Access Token de la aplicación "Mundo Mickey" (cuenta del dueño), sin comillas.
# En local y en el deploy de prueba de Vercel: el de las CREDENCIALES DE PRUEBA de la aplicación ("Activar credenciales").
# En producción (brief 12): el de las credenciales de PRODUCCIÓN. Los dos empiezan con APP_USR-: /api/health
# deja en el log si la cuenta es de prueba. Ver "Mercado Pago (panel nuevo)" en docs/DEPLOY.md.
MP_ACCESS_TOKEN=
# La Public Key no se usa: Checkout Pro redirige a Mercado Pago y no hay Bricks.
# MP_PUBLIC_KEY=

# Clave secreta de los webhooks de la aplicación (Webhooks → configurar notificaciones → "Clave secreta").
# Mostrala con el ojo antes de copiarla: copiada tapada son "•" y /api/health dice mpWebhook: "invalido".
# Valida la firma x-signature de cada notificación. Con credenciales de prueba (local y deploy de prueba), la del
# modo PRUEBA; en producción, la del modo PRODUCTIVO. Ver "Mercado Pago (panel nuevo)" en docs/DEPLOY.md.
MP_WEBHOOK_SECRET=
