# Solo las variables VITE_ llegan al navegador. Nunca pongas un secreto con prefijo VITE_.
# Copiá este archivo a .env y completá los valores. El .env no se versiona.

# --- API ---
# MongoDB Atlas, base "mundo-mickey" (ver docs/DEPLOY.md). Formato, con valores de ejemplo:
# mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/mundo-mickey?retryWrites=true&w=majority&appName=mundo-mickey
MONGODB_URI=
# URL pública del sitio: en local el front de Vite, en Vercel la URL del proyecto
SITE_URL=http://localhost:5173

# --- Front (públicas) ---
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# --- Sanity (API) ---
# Mismo proyecto y dataset que las VITE_. El token (rol Editor) es secreto: solo en el servidor y en los scripts.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=

# --- Login del panel (/admin) ---
# Usuario del único admin, por ejemplo: admin
ADMIN_USER=
# Hash bcrypt de la contraseña: generalo con `npm run admin:hash` y pegalo tal cual, sin comillas
ADMIN_PASSWORD_HASH=
# Secreto para firmar los JWT. Generalo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Brief 08: Mercado Pago ---
# MP_ACCESS_TOKEN=

# --- Brief 09: webhook de Mercado Pago ---
# MP_WEBHOOK_SECRET=
